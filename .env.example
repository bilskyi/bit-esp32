# Groq (https://console.groq.com) — required unless PROVIDER_MODE=mock
GROQ_API_KEY=

# "groq" for real providers, "mock" to test the audio path with no API key
PROVIDER_MODE=groq

LOG_LEVEL=info

# Total prompt (persona + memory + history) ceiling. Groq free tier is
# 6000 tokens/minute; history is trimmed to fit this.
MAX_CONTEXT_TOKENS=2000

# Also caps how much audio one utterance may buffer (60 s == 1.92 MB).
SESSION_TIMEOUT_S=60

# Shared secret the device sends as `Authorization: Bearer <token>`.
# Empty disables the check — only safe on a laptop.
DEVICE_TOKEN=

# Signs the web login's session cookie. Empty means a random key is
# generated per process start (fine for local dev, not for production —
# every restart invalidates existing logins).
SESSION_SECRET_KEY=

# Whether the session cookie requires HTTPS. True is correct in production.
# Set it False for local development and for testing from a phone over plain
# http:// on your LAN - otherwise the browser silently discards the cookie,
# /login returns 200 and every call after it returns 401.
SESSION_COOKIE_SECURE=False

# How much louder the reply leaves the server than the voice rendered it.
# The device's top volume step is already unity, so this is what "maximum
# volume" means. Peaks are limited to TTS_CEILING_DBFS afterwards, so raising
# it trades headroom for compression, not for clipping. 0 turns it off.
TTS_GAIN_DB=8.0
TTS_CEILING_DBFS=-1.0

DB_PATH=voice.db
